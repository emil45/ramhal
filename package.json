{
  "name": "ramhal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:build": "npm run db:migrate && npm run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "generate:types": "node scripts/dev-generate-types.mjs",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "node scripts/migrate.mjs",
    "migrate:create": "node scripts/dev-migrate.mjs create",
    "seed": "node scripts/seed.mjs",
    "seed:demo-news": "vite-node -c vitest.config.ts --options.deps.inline=payload-oauth2 scripts/seed-demo-news.mjs",
    "import:books": "vite-node -c vitest.config.ts --options.deps.inline=payload-oauth2 scripts/import-books.mjs",
    "import:prepared-covers": "vite-node -c vitest.config.ts --options.deps.inline=payload-oauth2 scripts/import-prepared-covers.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@base-ui/react": "^1.8.0",
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-s3": "^3.89.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "jose": "^5.10.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "payload": "^3.89.0",
    "payload-oauth2": "1.0.21",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tsx": "4.21.0"
  }
}
